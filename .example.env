# ============================================================================
# Spliqo Environment Variables Template (.example.env)
# ============================================================================
#
# Required variables are marked with ⚠️
# Optional variables are marked with ℹ️
#
# HOW CONFIGURATION WORKS (Infisical Centralization)
# ─────────────────────────────────────────────────────────────────────────────
#
#  🔐 Infisical Dashboard acts as the Single Source of Truth, organized into 3 folders:
#
#  📁 /public  →  Fetched dynamically at build/run time
#     Injected into Flutter Client via compile-time `--dart-define` flags.
#
#  📁 /runtime →  Backend Server Environment Variables
#     Injected dynamically into memory at boot time for Server/Container environments
#     wrapping the Infisical CLI (`infisical run --path=/public --path=/runtime -- ...`)
#     without storing plaintext secrets on disk.
#
#  📁 /ci      →  GitHub CI/CD Runner Secrets
#     Workflow runner automation credentials (signing keys, deployment triggers).
#     Never injected into application runtime containers.
#
# ─────────────────────────────────────────────────────────────────────────────

# ============================================================================
# 🔨 BUILD-TIME  (Infisical `/public` folder → injected into client via --dart-define)
# ============================================================================

# ⚠️ Application Name & Version
# 🔨 Build-time (Infisical `/public` folder)
APP_NAME=Spliqo
APP_VERSION=0.1.0

# ⚠️ Public Backend URL & Domain for client communication
# 🔨 Build-time (Infisical `/public` folder)
APP_DOMAIN=localhost:8000
BACKEND_URL=http://localhost:8000

# ⚠️ Supabase Public Project URL (Accessible by mobile clients)
# 🔨 Build-time (Infisical `/public` folder)
SUPABASE_URL=http://127.0.0.1:54321

# ⚠️ Supabase Anon Key (Public publishable key for client-side Auth & Realtime)
# 🔨 Build-time (Infisical `/public` folder)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# ℹ️ Sentry DSN for Flutter client crash reporting and error monitoring
# 🔨 Build-time (Infisical `/public` folder)
SENTRY_DSN=https://xxxx@xxxxx.ingest.de.sentry.io/xxxxxxxxxxxx

# ℹ️ Target environment slug (development, staging, production)
# 🔨 Build-time (Infisical `/public` folder)
ENVIRONMENT=development


# ============================================================================
# 🚀 RUNTIME  (Infisical `/runtime` folder → injected into backend process memory)
# ============================================================================

# ----------------------------------------------------------------------------
# Server Ports & Host Bindings
# ----------------------------------------------------------------------------

# ℹ️ FastApi Server Port and Host
# 🚀 Runtime (Infisical `/runtime` folder)
PORT=8000
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Database & Supabase Backend Credentials
# ----------------------------------------------------------------------------

# ⚠️ Direct PostgreSQL Database Connection String
# 🚀 Runtime (Infisical `/runtime` folder)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ⚠️ Supabase Service Role Key (Backend admin access, bypasses RLS)
# 🚀 Runtime (Infisical `/runtime` folder)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# ⚠️ Supabase JWT Secret for token verification
# 🚀 Runtime (Infisical `/runtime` folder)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-length

# ----------------------------------------------------------------------------
# 🔏 Infisical KMS Envelope Encryption (Zero-Trust Key Management)
# Replaces static FLE_KEY_HEX env var with KMS envelope encryption
# ----------------------------------------------------------------------------

# ⚠️ Infisical KMS Master Key ID (UUID of KMS Root Key used to wrap data encryption keys)
INFISICAL_KMS_KEY_ID=12345678-1234-1234-1234-123456789abc

# ⚠️ Infisical Universal Auth Machine Identity Credentials for KMS
# Production: Single-use bootstrap secret (maxUses=1, ttl=10m) burned into RAM on boot
INFISICAL_KMS_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_KMS_UNIVERSAL_AUTH_CLIENT_SECRET=

# ℹ️ Legacy Field-Level Encryption (FLE) hex keys (Deprecated fallback)
FLE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FLE_BLIND_INDEX_KEY_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# ----------------------------------------------------------------------------
# AI, Security & External Services
# ----------------------------------------------------------------------------

# ℹ️ Google Gemini API Key for receipt extraction & optical itemization
# 🚀 Runtime (Infisical `/runtime` folder)
GEMINI_API_KEY=AIzaSyDummyKeyForGeminiVision12345
GEMINI_MODEL_ID=gemini-2.0-flash

# ℹ️ Admin API Key for protected endpoints
# 🚀 Runtime (Infisical `/runtime` folder)
ADMIN_API_KEY=spliqo-admin-secret-key-32-characters

# ℹ️ HMAC Signing Key for session integrity
# 🚀 Runtime (Infisical `/runtime` folder)
HMAC_SIGNING_KEY=spliqo-hmac-sha256-signing-secret

# ℹ️ Redis URL for distributed rate limiting & caching (Optional)
# 🚀 Runtime (Infisical `/runtime` folder)
REDIS_URL=redis://127.0.0.1:6379/0

# ℹ️ Sentry DSN for backend crash reporting and tracing
# 🚀 Runtime (Infisical `/runtime` folder)
SENTRY_DSN_BACKEND=https://xxxx@xxxxx.ingest.de.sentry.io/xxxxxxxxxxxx


# ============================================================================
# 🤖 CI / CD  (Infisical `/ci` folder → injected into GitHub Actions runner)
# ============================================================================

# ℹ️ Deployment Webhook Trigger URL for Coolify / Docker Swarm
# 🤖 CI (Infisical `/ci` folder)
DEPLOY_WEBHOOK_URL=https://coolify.spliqo.dev/api/v1/deploy?uuid=xxxxxx

# ℹ️ Codecov token for test coverage reporting
# 🤖 CI (Infisical `/ci` folder)
CODECOV_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
