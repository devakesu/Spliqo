{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Debug Server (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "app"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "FastAPI: Run Server (Infisical /public + /runtime)",
      "type": "node-terminal",
      "request": "launch",
      "command": "${workspaceFolder}/scripts/run_server.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flutter: Android",
      "cwd": "spliqo_client",
      "request": "launch",
      "type": "dart",
      "deviceId": "android",
      "customTool": "${workspaceFolder}/spliqo_client/tool/flutter_infisical.sh"
    },
    {
      "name": "Flutter: iOS",
      "cwd": "spliqo_client",
      "request": "launch",
      "type": "dart",
      "deviceId": "ios",
      "customTool": "${workspaceFolder}/spliqo_client/tool/flutter_infisical.sh"
    }
  ]
}
